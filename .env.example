# Required - Get from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Database (Docker Compose - uses service name 'postgres')
DATABASE_URL=postgresql://user:password@postgres:5432/langgraph

# For local development without Docker, use:
# DATABASE_URL=postgresql://user:password@localhost:5432/langgraph

# Langfuse - Optional for tracing (get from http://localhost:3000 after first login)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# LLM Configuration (optional - defaults shown)
# LLM_MODEL=gemini-2.5-flash
# LLM_TEMPERATURE=0.7

# Tools Configuration (optional - defaults shown)
# TOOLS_WORKSPACE_DIR=/tmp/agent_workspace
# TOOLS_ENABLED_CATEGORIES=math,files

# Logging (optional - defaults shown)
# LOG_LEVEL=INFO